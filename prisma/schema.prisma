generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexão direta (sem pooler) para migrations. Localmente pode ser igual à DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  CANDIDATE
  COMPANY
  ADMIN
}

enum JobStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum ContractType {
  CLT
  PJ
  INTERNSHIP
  TEMPORARY
}

enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum ApplicationStatus {
  SUBMITTED
  IN_REVIEW
  IN_PROCESS
  INTERVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  name               String
  passwordHash       String
  role               Role
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  candidate          CandidateProfile?
  company            CompanyProfile?
  notifications      Notification[]
  image              UserImage?
  // Preenchido quando a pessoa confirma o e-mail pelo link enviado.
  emailVerified      DateTime?
  // Incrementado ao trocar ou redefinir a senha: invalida as sessões abertas.
  sessionVersion     Int               @default(0)
  authTokens         AuthToken[]
  // Preferência da janela de Configurações: também receber por e-mail as notificações do site.
  emailNotifications Boolean           @default(true)
  supportTickets     SupportTicket[]
  supportMessages    SupportMessage[]
  // Aceite dos Termos de Uso e da Política de Privacidade (LGPD): quando e qual versão.
  termsAcceptedAt    DateTime?
  termsVersion       String?
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Tokens de uso único enviados por e-mail. Só o hash SHA-256 fica no banco.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

// Foto do candidato ou logotipo da empresa. Fica no banco para não depender de serviço
// externo de arquivos (o disco da Vercel é somente leitura). Limite de tamanho na aplicação.
model UserImage {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  size      Int
  updatedAt DateTime @updatedAt
}

model CandidateProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String?
  about           String?
  location        String?
  interestArea    String?
  workMode        WorkMode?
  objective       String?
  linkedinUrl     String?
  yearsExperience Int              @default(0)
  /// CEP e coordenadas aproximadas, só para estimar o tempo de deslocamento até as vagas
  postalCode      String?
  lat             Float?
  lng             Float?
  /// WhatsApp opcional: a empresa só vê o número quando o candidato autoriza
  whatsapp        String?
  whatsappOptIn   Boolean          @default(false)
  skills          CandidateSkill[]
  skillChecks     SkillCheck[]
  projects        Project[]
  checkins        HireCheckin[]
  educations      Education[]
  experiences     Experience[]
  applications    JobApplication[]
  savedJobs       SavedJob[]
  views           ResumeView[]
  updatedAt       DateTime         @updatedAt
}

model Education {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  institution String
  course      String
  startYear   Int
  endYear     Int?

  @@index([candidateId])
}

model Experience {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company     String
  role        String
  description String?
  startDate   DateTime
  endDate     DateTime?

  @@index([candidateId])
}

model Skill {
  id         String           @id @default(cuid())
  name       String           @unique
  candidates CandidateSkill[]
  jobs       JobSkill[]
}

model CandidateSkill {
  candidateId String
  skillId     String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  /// quando a pessoa passou na prova desta habilidade (selo "comprovada")
  verifiedAt  DateTime?

  @@id([candidateId, skillId])
}

model CompanyProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  industry    String?
  website     String?
  location    String?
  /// CNPJ (só dígitos), conferido na BrasilAPI; a razão social vem de lá
  cnpj           String?   @unique
  legalName      String?
  cnpjVerifiedAt DateTime?
  /// dados para estimar as cotas de Aprendiz e PcD (informados pela empresa)
  employees      Int?
  companySize    String?
  apprentices    Int?
  pcdEmployees   Int?
  jobs        Job[]
  resumeViews ResumeView[]
}

model Job {
  id               String           @id @default(cuid())
  companyId        String
  company          CompanyProfile   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title            String
  description      String
  responsibilities String?
  requirements     String?
  benefits         String?
  area             String
  location         String
  workMode         WorkMode
  contractType     ContractType
  seniority        Seniority
  salaryMin        Int?
  salaryMax        Int?
  minYears         Int              @default(0)
  status           JobStatus        @default(ACTIVE)
  flagged          Boolean          @default(false)
  publishedAt      DateTime         @default(now())
  /// última vez que a empresa confirmou que ainda contrata; sem confirmação por 30 dias, a vaga sai do ar
  confirmedAt      DateTime         @default(now())
  /// preenchido quando a vaga foi pausada por falta de confirmação
  expiredAt        DateTime?
  /// vaga de Jovem Aprendiz / vaga exclusiva para pessoas com deficiência
  forApprentice    Boolean          @default(false)
  pcdOnly          Boolean          @default(false)
  /// CEP do local de trabalho e coordenadas aproximadas (estimativa de deslocamento)
  postalCode       String?
  lat              Float?
  lng              Float?
  reports          JobReport[]
  updatedAt        DateTime         @updatedAt
  skills           JobSkill[]
  applications     JobApplication[]
  saved            SavedJob[]

  @@index([status, publishedAt])
  @@index([status, confirmedAt])
  @@index([companyId])
}

model JobSkill {
  jobId   String
  skillId String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
}

model JobApplication {
  id            String                     @id @default(cuid())
  jobId         String
  candidateId   String
  job           Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate     CandidateProfile           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status        ApplicationStatus          @default(SUBMITTED)
  coverNote     String?
  compatibility Int?
  /// quando o candidato foi avisado de que a empresa não respondeu em 14 dias
  noReplyNotifiedAt DateTime?
  /// motivo escolhido pela empresa ao recusar e habilidades que faltaram
  rejectReason  String?
  rejectSkills  String[]                   @default([])
  /// data da aprovação (início do acompanhamento de 90 dias)
  hiredAt       DateTime?
  checkins      HireCheckin[]
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  history       ApplicationStatusHistory[]

  @@unique([jobId, candidateId])
  @@index([candidateId])
}

model ApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String
  application   JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  changedById   String?
  createdAt     DateTime          @default(now())

  @@index([applicationId])
}

model SavedJob {
  candidateId String
  jobId       String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@id([candidateId, jobId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  /// página do site que resolve o aviso (ex.: /checkin/abc); a notificação vira um link
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

enum SupportCategory {
  ACCOUNT
  JOBS
  APPLICATIONS
  BUG
  OTHER
}

enum SupportStatus {
  OPEN
  ANSWERED
  CLOSED
}

// Pedido de suporte aberto por um usuário; a conversa fica em SupportMessage.
model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  SupportCategory
  status    SupportStatus    @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]

  @@index([userId, status])
  @@index([status, updatedAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  fromStaff Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

/// Uma linha por empresa que abriu o currículo de um candidato (o candidato vê a lista).
model ResumeView {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyId   String
  company     CompanyProfile   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  count       Int              @default(1)
  firstAt     DateTime         @default(now())
  lastAt      DateTime         @default(now())

  @@unique([candidateId, companyId])
  @@index([candidateId, lastAt])
}

/// Tentativa de prova de habilidade: as questões sorteadas ficam guardadas no servidor.
model SkillCheck {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       String
  questionIds String[]
  score       Int?
  total       Int
  passed      Boolean          @default(false)
  startedAt   DateTime         @default(now())
  finishedAt  DateTime?

  @@index([candidateId, skill, startedAt])
}

/// Projeto do curso técnico confirmado por um professor por link de uso único.
model Project {
  id            String           @id @default(cuid())
  candidateId   String
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title         String
  description   String
  url           String?
  school        String
  teacherName   String
  teacherEmail  String
  tokenHash     String?          @unique
  validatedAt   DateTime?
  validatorNote String?
  createdAt     DateTime         @default(now())

  @@index([candidateId])
}

/// Pergunta de acompanhamento aos 30, 60 e 90 dias depois da contratação.
model HireCheckin {
  id            String           @id @default(cuid())
  applicationId String
  application   JobApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  day           Int
  role          Role
  score         Int?
  wantsTalk     Boolean          @default(false)
  comment       String?
  createdAt     DateTime         @default(now())
  answeredAt    DateTime?

  @@unique([applicationId, day, role])
}

/// Denúncia de vaga suspeita; três denúncias retêm a vaga para a moderação.
model JobReport {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  reason    String
  createdAt DateTime @default(now())

  @@unique([jobId, userId])
}
