# PostgreSQL (local: docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nautiwork?schema=public"
# Conexão direta usada pelas migrations (no Neon, a URL sem pooler). Localmente, repita a DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/nautiwork?schema=public"
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Banco separado para os testes de integração (npm run test:integration). O teste APAGA esse banco.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nautiwork_test?schema=public"

# Endereço público usado nos links dos e-mails (obrigatório em produção).
APP_URL="http://localhost:3000"
# E-mail transacional pelo Resend (https://resend.com). Sem estas duas, os e-mails não são enviados:
# em desenvolvimento aparecem no console do servidor.
RESEND_API_KEY=""
EMAIL_FROM="Nautiwork <nao-responda@seu-dominio.com.br>"
# Só para testes locais: grava os e-mails neste arquivo em vez de enviar (usado pelo test:smoke).
MAIL_DEV_OUTBOX=""
# Limite de tentativas compartilhado entre instâncias (Upstash Redis). Sem estas, fica em memória.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Para onde vão os pedidos de suporte (não aparece no site; a resposta vai direto para quem abriu o pedido).
SUPPORT_EMAIL=""

# Monitoramento de erros (Sentry). Sem o DSN o SDK fica desligado.
# Pela integração do Sentry na Vercel essas variáveis são criadas sozinhas.
NEXT_PUBLIC_SENTRY_DSN=""
# Opcionais, para enviar os source maps no build (erros com o código original):
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
