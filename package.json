{
  "name": "nautiwork",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:smoke": "node scripts/smoke-test.mjs",
    "vercel-build": "prisma generate && prisma migrate deploy && node scripts/seed-on-deploy.mjs && next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.186",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^11.17.0",
    "ai": "^7.0.181",
    "bcryptjs": "^2.4.3",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.39",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.33"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
